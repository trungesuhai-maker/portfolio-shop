# SUPABASE ENVIRONMENT VARIABLES
VITE_SUPABASE_URL="https://your-preview-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_CONNECTION_STRING="postgresql://postgres:password@db.your-prod-project.supabase.co:5432/postgres"
SUPABASE_PREVIEW_CONNECTION_STRING="postgresql://postgres:password@db.your-preview-project.supabase.co:5432/postgres"

# GITHUB CONFIG
GITHUB_PAT="ghp_your_personal_access_token"
GITHUB_OWNER="your-github-username"
GITHUB_REPO="portfolio-shop"
GITHUB_BRANCH="main"

# CLOUDFLARE R2 OBJECT STORAGE CREDENTIALS
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="portfolio-shop"
R2_TOKEN_NAME="shopportfolio-api-token"
R2_API_TOKEN="your_r2_api_token"
R2_PUBLIC_DOMAIN="https://your-r2-public-domain.r2.dev"
